{
  "name": "wharf-archive",
  "version": "1.6.1",
  "description": "Local-first 3D/2D asset manager with Google Drive sync",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RossLadinor/wharf-archive.git"
  },
  "homepage": "https://github.com/RossLadinor/wharf-archive#readme",
  "bugs": "https://github.com/RossLadinor/wharf-archive/issues",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "setup": "node node_modules/electron/install.js && npm run rebuild",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "generate-icon": "node scripts/generate-icon.js",
    "package": "node scripts/generate-icon.js && electron-vite build && electron-builder"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "googleapis": "^140.0.0",
    "marked": "^18.0.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "vite": "^5.2.0"
  },
  "build": {
    "appId": "com.wharfarchive.app",
    "productName": "Wharf Archive",
    "copyright": "Wharf Archive",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/bindings/**/*"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "artifactName": "Wharf-Archive-${version}-mac-${arch}.${ext}",
      "category": "public.app-category.graphics-design",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "Wharf-Archive-${version}-mac-${arch}.dmg"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Wharf Archive",
      "artifactName": "Wharf-Archive-${version}-win-x64-Setup.exe"
    },
    "portable": {
      "artifactName": "Wharf-Archive-${version}-win-x64-Portable.exe"
    }
  }
}
